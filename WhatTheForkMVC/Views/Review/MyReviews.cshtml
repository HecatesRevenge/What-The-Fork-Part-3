@using WhatTheForkMVC.Classes
@using WhatTheForkMVC.Database
@using WhatTheForkMVC.Classes.Reviews;
@model List<Review>
@{
    ViewData["Title"] = "My Reviews";
}
<div class="search-hero">
    <div class="container">
        <p class="eyebrow">Reviewer Dashboard</p>
        <h1>My Reviews</h1>
        <p class="lead">Edit, modify, or delete your existing reviews.</p>
    </div>
</div>

<div class="container search-main">
    @if (ViewData["Message"] != null)
    {
        <span class="success-message d-block">@ViewData["Message"]</span>
    }
    @if (ViewData["Error"] != null)
    {
        <span class="validation-summary d-block">@ViewData["Error"]</span>
    }

    @if (ViewData["ConfirmDelete"] != null)
    {
        <div class="account-card confirm-card">
            <p>@ViewData["ConfirmDelete"]</p>
            <form method="post" asp-controller="Review" asp-action="DeleteReview">
                <input type="hidden" name="reviewID" value="@ViewData["DeleteReviewID"]" />
                <button type="submit" class="btn btn-wtf">Yes</button>
                <a asp-controller="Review" asp-action="MyReviews" class="btn btn-outline-light">No</a>
            </form>
        </div>
    }

    <div class="results-toolbar d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h2 class="results-count">@ViewData["ReviewCount"]</h2>
        <a class="btn btn-wtf btn-sm" asp-controller="Restaurant" asp-action="Search">Find a restaurant to review</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="results-criteria">You haven't written any reviews yet. Search for a restaurant to review.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle results-grid">
                <thead>
                    <tr class="grid-header">
                        <th>Restaurant</th>
                        <th>Title</th>
                        <th>Visited</th>
                        <th class="text-center">Food</th>
                        <th class="text-center">Service</th>
                        <th class="text-center">Atmosphere</th>
                        <th class="text-center">Price</th>
                        <th>Posted</th>
                        <th></th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Review review in Model)
                    {
                        <tr class="grid-row">
                            <td class="restaurant-name">@review.RestaurantName</td>
                            <td>@review.ReviewTitle</td>
                            <td class="muted-cell">@(review.VisitDate == DateTime.MinValue ? "-" : review.VisitDate.ToString("MMM d, yyyy"))</td>
                            <td class="score">@review.FoodRating</td>
                            <td class="score">@review.ServiceRating</td>
                            <td class="score">@(review.AtmosphereRating == 0 ? "-" : review.AtmosphereRating.ToString())</td>
                            <td class="price-text text-center">@RestaurantDB.GetDollarSigns(review.PriceRating)</td>
                            <td class="muted-cell">@review.ReviewDate.ToString("MMM d, yyyy")</td>
                            <td><a asp-controller="Restaurant" asp-action="Profile" asp-route-id="@review.RestaurantID" class="btn-view">View</a></td>
                            <td><a asp-controller="Review" asp-action="WriteReview" asp-route-reviewID="@review.ReviewID" class="btn-view">Edit</a></td>
                            <td><a asp-controller="Review" asp-action="ConfirmDelete" asp-route-reviewID="@review.ReviewID" asp-route-restaurantName="@review.RestaurantName" class="btn-delete">Delete</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>