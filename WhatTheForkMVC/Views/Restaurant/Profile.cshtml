@using System.Data
@using WhatTheForkMVC.Classes.Reviews;
@using What_The_Fork.Styling.Reviews
@{
    DataRow restaurant = (DataRow)ViewData["Restaurant"];
}

@if (restaurant == null)
{
    <div class="container profile-message">
        <h1>@ViewData["MessageTitle"]</h1>
        <p>@ViewData["MessageText"]</p>
        <a class="btn btn-wtf" asp-controller="Restaurant" asp-action="Search">Back to search</a>
    </div>
}
else
{
    DataTable gallery = (DataTable)ViewData["Gallery"];
    DataSet dsHours = (DataSet)ViewData["Hours"];
    DataSet dsSocial = (DataSet)ViewData["SocialLinks"];
    List<Review> reviews = (List<Review>)ViewData["Reviews"];
    int restaurantID = Convert.ToInt32(restaurant["RestaurantID"]);
    int reviewCount = Convert.ToInt32(restaurant["ReviewCount"]);

    if (ViewData["CoverUrl"].ToString() != "")
    {
        <div class="profile-cover">
            <img src="@Url.Content(ViewData["CoverUrl"].ToString())" class="profile-cover-img" alt="" />
        </div>
    }

    <div class="container profile-main">
        <a class="back-link" asp-controller="Restaurant" asp-action="Search">Back to search results</a>

        <div class="profile-header-card">
            <img src="@Url.Content(ViewData["LogoUrl"].ToString())" class="profile-logo" alt="@restaurant["RestaurantName"] logo" />
            <div class="profile-title">
                <h1>@restaurant["RestaurantName"]</h1>
                <div class="profile-meta">
                    <span class="cuisine-badge">@restaurant["CuisineName"]</span>
                    <span class="price-text">@(new String('$', Convert.ToInt32(restaurant["PriceRange"])))</span>
                    <span>@restaurant["City"], @restaurant["State"]</span>
                </div>
            </div>
            <div class="profile-overall">
                @if (reviewCount == 0)
                {
                    <span class="profile-overall-number">New</span>
                    <span class="profile-review-count">No reviews yet</span>
                }
                else
                {
                    double overall = Convert.ToDouble(restaurant["OverallRating"]);
                    <span class="profile-overall-number">@overall.ToString("0.0")</span>
                    <div>@Html.Raw(ReviewDivs.GetStarsHtml(overall))</div>
                    <span class="profile-review-count">@(reviewCount == 1 ? "1 review" : reviewCount + " reviews")</span>
                }
            </div>
            @if ((bool)ViewData["ShowReserve"])
            {
                <a class="btn btn-wtf profile-reserve" href="@Url.Content("~/Reservation/MakeReservation/" + restaurantID)">Reserve a Table</a>
            }
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="profile-card">
                    <h2>About</h2>
                    <p class="profile-description">@restaurant["Description"]</p>
                </div>

                <div class="profile-card">
                    <h2>Gallery</h2>
                    @if (gallery.Rows.Count == 0)
                    {
                        <span class="text-muted-light">No photos yet.</span>
                    }
                    else
                    {
                        <div class="gallery-grid">
                            @foreach (DataRow photo in gallery.Rows)
                            {
                                <figure class="gallery-item">
                                    <img src="@photo["ImageUrl"]" class="gallery-img" alt="@photo["Caption"]" />
                                    <figcaption class="gallery-caption">@photo["Caption"]</figcaption>
                                </figure>
                            }
                        </div>
                    }
                </div>

                <div class="profile-card">
                    <h2>Ratings</h2>
                    @if (reviewCount == 0)
                    {
                        <p class="text-muted-light mb-0">Ratings will appear following the first review.</p>
                    }
                    else
                    {
                        @Html.Raw(ReviewDivs.GetRatingBarsHtml(
                            //Review later, but for now just use the values from the restaurant row
                            restaurant["FoodRating"] == DBNull.Value ? 0 : Convert.ToDouble(restaurant["FoodRating"]),
                            restaurant["ServiceRating"] == DBNull.Value ? 0 : Convert.ToDouble(restaurant["ServiceRating"]),
                            restaurant["AtmosphereRating"] == DBNull.Value ? 0 : Convert.ToDouble(restaurant["AtmosphereRating"]),
                            restaurant["PriceRating"] == DBNull.Value ? 0 : Convert.ToDouble(restaurant["PriceRating"])))
                    }
                </div>

                <div class="profile-card">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <h2 class="mb-0">Reviews (@reviews.Count)</h2>
                        @if (ViewData["WriteReviewUrl"] != null)
                        {
                            <a class="btn btn-wtf btn-sm" href="@Url.Content(ViewData["WriteReviewUrl"].ToString())">@ViewData["WriteReviewText"]</a>
                        }
                    </div>

                    <partial name="_ReviewList" model="reviews" />
                </div>
            </div>

            <div class="col-lg-4">
                <div class="profile-card">
                    <h2>Contact &amp; Location</h2>
                    <div class="contact-item">
                        <span class="contact-label">Address</span>
                        <span>@restaurant["StreetAddress"]<br />@restaurant["City"], @restaurant["State"] @restaurant["ZipCode"]</span>
                    </div>
                    <div class="contact-item">
                        <span class="contact-label">Phone</span>
                        @if (restaurant["Phone"] == DBNull.Value || restaurant["Phone"].ToString() == "")
                        {
                            <span>Not listed</span>
                        }
                        else
                        {
                            <a href="tel:@restaurant["Phone"]">@restaurant["Phone"]</a>
                        }
                    </div>
                    <div class="contact-item">
                        <span class="contact-label">Email</span>
                        @if (restaurant["Email"] == DBNull.Value || restaurant["Email"].ToString() == "")
                        {
                            <span>Not listed</span>
                        }
                        else
                        {
                            <a href="mailto:@restaurant["Email"]">@restaurant["Email"]</a>
                        }
                    </div>
                    <div class="contact-item">
                        <span class="contact-label">Website</span>
                        @if (restaurant["WebsiteUrl"] == DBNull.Value || restaurant["WebsiteUrl"].ToString() == "")
                        {
                            <span>Not listed</span>
                        }
                        else
                        {
                            <a href="@restaurant["WebsiteUrl"]" target="_blank">@restaurant["WebsiteUrl"]</a>
                        }
                    </div>
                    <div class="contact-item">
                        <span class="contact-label">Owner</span>
                        <span>@(restaurant["OwnerName"] == DBNull.Value || restaurant["OwnerName"].ToString() == "" ? "Not listed" : restaurant["OwnerName"])</span>
                    </div>
                    <div class="contact-item">
                        <span class="contact-label">Social Media</span>
                        @if (dsSocial.Tables[0].Rows.Count == 0)
                        {
                            <span>Not listed</span>
                        }
                        else
                        {
                            <div class="social-links">
                                @foreach (DataRow link in dsSocial.Tables[0].Rows)
                                {
                                    <div><a href="@link["LinkUrl"]" target="_blank" class="social-link">@link["PlatformName"]</a></div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="profile-card">
                    <h2>Hours</h2>
                    @if (dsHours.Tables[0].Rows.Count == 0)
                    {
                        <span>No hours available</span>
                    }
                    else
                    {
                        <table class="hours-table">
                            @foreach (DataRow day in dsHours.Tables[0].Rows)
                            {
                                <tr>
                                    <td>@day["Day"]</td>
                                    <td>@day["Hours"]</td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}
