@model DataSet
@{
    ViewData["Title"] = "Find Restaurants";
    DataSet dsCuisines = (DataSet)ViewData["Cuisines"];
    DataSet dsLocations = (DataSet)ViewData["Locations"];
    String selectedCuisines = (String)ViewData["SelectedCuisines"];
    String selectedLocation = (String)ViewData["SelectedLocation"];
}
<div class="search-hero">
    <div class="container">
        <p class="eyebrow">Restaurant reviews from real diners</p>
        <h1>Find your next favorite plate</h1>
        <p class="lead">Choose one or more cuisines and a location, then compare ratings for food, service and price.</p>
    </div>
</div>

<div class="container search-main">
    <div class="row g-4">

        <div class="col-lg-4 col-xl-3">
            <form asp-controller="Restaurant" asp-action="Search" method="post" class="filter-card">
                <h2 class="filter-title">Refine Search</h2>

                @if (ViewData["Validation"] != null)
                {
                    <span class="validation-summary d-block">@ViewData["Validation"]</span>
                }

                <div class="filter-section">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="filter-label">Cuisines</span>
                        <div>
                            <button type="submit" name="command" value="All" class="btn btn-outline-light btn-sm">All</button>
                            <button type="submit" name="command" value="Clear" class="btn btn-outline-light btn-sm">Clear</button>
                        </div>
                    </div>
                    <p class="filter-hint">Choose one or more cuisines.</p>
                    <ul class="cuisine-chips">
                        @if (dsCuisines != null)
                        {
                            foreach (DataRow row in dsCuisines.Tables[0].Rows)
                            {
                                String cuisineID = row["CuisineID"].ToString();
                                bool isChecked = selectedCuisines == "all" || selectedCuisines.Contains("," + cuisineID + ",");
                                <li>
                                    <input type="checkbox" id="cuisine@(cuisineID)" name="cuisines" value="@cuisineID" checked="@isChecked" />
                                    <label for="cuisine@(cuisineID)">@row["CuisineName"]</label>
                                </li>
                            }
                        }
                    </ul>
                </div>

                <div class="filter-section">
                    <label for="location" class="filter-label">Location</label>
                    <select id="location" name="location" class="form-select mt-2">
                        <option value="">All Locations</option>
                        @if (dsLocations != null)
                        {
                            foreach (DataRow row in dsLocations.Tables[0].Rows)
                            {
                                String value = row["City"] + "|" + row["State"];
                                <option value="@value" selected="@(value == selectedLocation)">@row["City"], @row["State"] (@row["RestaurantCount"])</option>
                            }
                        }
                    </select>
                    <p class="filter-hint mt-2 mb-0">Choose a city, or select "All Locations".</p>
                </div>

                <button type="submit" name="command" value="Search" class="btn btn-wtf w-100">Search restaurants</button>
            </form>
        </div>

        <div class="col-lg-8 col-xl-9">
            @if (ViewData["Error"] != null)
            {
                <span class="alert alert-danger d-block">@ViewData["Error"]</span>
            }

            <div class="results-toolbar">
                @if (ViewData["ResultCount"] == null)
                {
                    <h2 class="results-count">Where are we eating?</h2>
                    <p class="results-criteria">Pick the cuisines you're craving and a location, then click Search restaurants.</p>
                }
                else
                {
                    <h2 class="results-count">@ViewData["ResultCount"]</h2>
                    <p class="results-criteria">@ViewData["Criteria"]</p>
                }
            </div>

            @if (Model != null && Model.Tables[0].Rows.Count == 0)
            {
                <p class="results-criteria">No restaurants match your search. Try adding more cuisines or choosing All Locations.</p>
            }

            @if (Model != null && Model.Tables[0].Rows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle results-grid">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Restaurant</th>
                                <th>Cuisine</th>
                                <th>Location</th>
                                <th class="text-center">Atmosphere</th>
                                <th class="text-center">Cost</th>
                                <th class="text-center">Overall</th>
                                <th class="text-center">Food</th>
                                <th class="text-center">Service</th>
                                <th class="text-center">Price</th>
                                <th class="text-center">Reviews</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow row in Model.Tables[0].Rows)
                            {
                                <tr>
                                    <td><img src="@Url.Content(row["LogoUrl"].ToString())" alt="@row["RestaurantName"] logo" class="grid-logo" /></td>
                                    <td class="restaurant-name">@row["RestaurantName"]</td>
                                    <td>@row["CuisineName"]</td>
                                    <td class="muted-cell">@row["Location"]</td>
                                    <td class="score text-center">@(row["AtmosphereRating"] == DBNull.Value ? "-" : String.Format("{0:0.0}", row["AtmosphereRating"]))</td>
                                    <td class="price-text text-center">@row["PriceLevel"]</td>
                                    <td class="score text-center">@(row["OverallRating"] == DBNull.Value ? "New" : String.Format("{0:0.0}", row["OverallRating"]))</td>
                                    <td class="score text-center">@(row["FoodRating"] == DBNull.Value ? "-" : String.Format("{0:0.0}", row["FoodRating"]))</td>
                                    <td class="score text-center">@(row["ServiceRating"] == DBNull.Value ? "-" : String.Format("{0:0.0}", row["ServiceRating"]))</td>
                                    <td class="score text-center">@(row["PriceRating"] == DBNull.Value ? "-" : String.Format("{0:0.0}", row["PriceRating"]))</td>
                                    <td class="score muted-cell text-center">@row["ReviewCount"]</td>
                                    <td class="text-end">
                                        <a asp-controller="Restaurant" asp-action="Profile" asp-route-id="@row["RestaurantID"]" class="btn-view">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>

