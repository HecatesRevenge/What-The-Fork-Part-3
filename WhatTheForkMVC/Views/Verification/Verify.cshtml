@{
    ViewData["Title"] = "Verify Account";
}
<div class="container search-main">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="account-card">
                <h2 class="filter-title">Account Verification</h2>

                @if (ViewData["Message"] != null)
                {
                    <span class="success-message d-block">@ViewData["Message"]</span>
                }
                @if (ViewData["Error"] != null)
                {
                    <span class="error-message d-block">@ViewData["Error"]</span>
                }

                <a asp-controller="Account" asp-action="Login" class="btn btn-wtf w-100 mt-3">Go to Log In</a>
            </div>
        </div>
    </div>
</div>