    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Forgot Info?";
    ViewData["Message"] = "Enter your email and press the 'New Question' button to get started!";
    ViewData["EmailMsg"] = "Input your email here";
}

    <div>


        @*
        Question and answer box
    *@
        <div class="account-field">
            <label Ifor="question" class="filter-label">@ViewData["Message"]</label>
            <input type="text" id="answer" name="answer" class="form-control mt-1" />
        </div>
        @*
            Email input
        *@
    <div class="account-field">
        <label Ifor="emailLabel" class="filter-label">@ViewData["EmailMsg"]</label>
        <input type="text" id="email" name="email" class="form-control mt-1" />
    </div>
    <p class="account-switch"><a asp-controller="GetInfoController" asp-action="NewQuestion">Get a new question</a></p>
    <p class="account-switch"><a asp-controller="GetInfoController" asp-action="Submit">Submit your answer</a></p>
 
    </div>

