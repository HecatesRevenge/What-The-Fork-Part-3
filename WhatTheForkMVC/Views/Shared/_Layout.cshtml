@using WhatTheForkMVC.Classes.Login;
@{
    UserAccounts user = SessionUser.GetUser(Context.Session);
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | What the Fork</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-md site-navbar" aria-label="Main navigation">
        <div class="container">
            <a class="navbar-brand brand" asp-controller="Restaurant" asp-action="Search">
                <span class="brand-mark"></span>
                <span class="brand-name">What the <em>Fork</em></span>
            </a>
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" asp-controller="Restaurant" asp-action="Search">Find Restaurants</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                @if (user == null)
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                    <li class="nav-item"><a class="btn btn-wtf btn-sm ms-md-2" asp-controller="Account" asp-action="Register">Register</a></li>
                }
                else
                {
                    <li class="nav-item"><span class="nav-user">Hi, @user.FirstName <span class="nav-user-type">@user.UserType</span></span></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Logout">Log out</a></li>
                }
            </ul>
        </div>
    </nav>

    @RenderBody()

    <footer class="site-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
            <div>
                <span class="brand-name">What the <em>Fork</em></span>
                <div>Honest reviews for hungry people.</div>
            </div>
            <div class="text-md-end">
                <div>CIS 3342 | Temple University</div>
            </div>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
